# Backend environment sample for local/dev setup
# Copy this file to .env and replace placeholder values.

# Server
PORT=8080

# Required core settings
DATABASE_URL=postgresql://<user>:<password>@localhost:5432/notorious
JWT_SECRET=<long-random-secret-min-32-chars>

# OpenSearch (required for search APIs)
AWS_REGION=us-east-1
OPENSEARCH_ENDPOINT=https://<your-opensearch-endpoint>
OPENSEARCH_INDEX=<primary-index>
# Optional: comma-separated list of indices for multi-index search
OPENSEARCH_INDICES=<index-a>,<index-b>
OPENSEARCH_MASTER_USER=<opensearch-username>
OPENSEARCH_MASTER_PASSWORD=<opensearch-password>

# Optional: S3 multipart upload/ingestion support
S3_UPLOAD_BUCKET=<bucket-name>
S3_UPLOAD_PREFIX=ingest/raw/
AWS_ACCESS_KEY_ID=<aws-access-key-id>
AWS_SECRET_ACCESS_KEY=<aws-secret-access-key>

# Optional: GeoIP database path (fallback is ./GeoLite2-City.mmdb)
# GEOIP_DB_PATH=./GeoLite2-City.mmdb

# Optional: OpenSearch ingest tuning
# OPENSEARCH_BULK_MAX_ATTEMPTS=5
# OPENSEARCH_BULK_RETRY_BASE=2s
# INGEST_BATCH_SIZE=7500
# INGEST_WORKER_MULTIPLIER=2
