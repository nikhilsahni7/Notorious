#!/usr/bin/env bash
# First-boot bootstrap for a fresh notorious EC2 instance.
# Rendered by Terraform (infra/main.tf). Safe to re-run manually.
set -Eeuo pipefail
export DEBIAN_FRONTEND=noninteractive

REGION="${aws_region}"
DOMAIN="${domain}"
BUCKET="${bucket}"
OS_HOST="${opensearch_host}"
OS_INDEX="${opensearch_index}"
SECRET_ID="${secret_id}"

APP_DIR="/home/ubuntu/notorious/backend"
mkdir -p "$APP_DIR" /opt/notorious /data
chown -R ubuntu:ubuntu /home/ubuntu/notorious /opt/notorious

# --- Packages -------------------------------------------------------------
apt-get update -y
apt-get install -y curl unzip jq nginx certbot python3-certbot-nginx postgresql postgresql-contrib docker.io

# AWS CLI v2 (used for S3 downloads / secret fetch via the instance IAM role)
if ! command -v aws >/dev/null 2>&1; then
  curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o /tmp/awscliv2.zip
  unzip -q -o /tmp/awscliv2.zip -d /tmp
  /tmp/aws/install --update
fi

systemctl enable --now docker
usermod -aG docker ubuntu

# --- Data volume (/data holds the ~500GB JSON file) -----------------------
# Find the attached (non-root) NVMe disk, format once, mount at /data.
# The volume attachment can land after first boot starts, so wait for it and
# fail loudly rather than letting the 500GB download fill the root volume.
ROOT_DISK=$(lsblk -no PKNAME "$(findmnt -no SOURCE /)" | head -1)
DATA_DEV=""
for _ in $(seq 1 30); do
  for DEV in /dev/nvme*n1; do
    [ -b "$DEV" ] || continue
    [ "/dev/$ROOT_DISK" = "$DEV" ] && continue
    DATA_DEV="$DEV"; break 2
  done
  sleep 10
done
[ -n "$DATA_DEV" ] || { echo "ERROR: data volume never appeared" >&2; exit 1; }
if ! blkid "$DATA_DEV" >/dev/null 2>&1; then
  mkfs.ext4 -q "$DATA_DEV"
fi
UUID=$(blkid -s UUID -o value "$DATA_DEV")
grep -q "$UUID" /etc/fstab || echo "UUID=$UUID /data ext4 defaults,nofail 0 2" >> /etc/fstab
mount -a
findmnt /data >/dev/null || { echo "ERROR: /data is not a mounted filesystem" >&2; exit 1; }
chown ubuntu:ubuntu /data

# --- Secrets + .env --------------------------------------------------------
# Fetched with the instance IAM role from Secrets Manager. Never baked into
# this script or Terraform state output.
SECRET_JSON=$(aws secretsmanager get-secret-value --region "$REGION" \
  --secret-id "$SECRET_ID" --query SecretString --output text)
DB_NAME=$(echo "$SECRET_JSON" | jq -r .database_name)
DB_USER=$(echo "$SECRET_JSON" | jq -r .database_user)
DB_PASS=$(echo "$SECRET_JSON" | jq -r .database_password)
DB_PASS_URLENCODED=$(echo "$SECRET_JSON" | jq -r '.database_password | @uri')
DB_PASS_SQL=$(printf %s "$DB_PASS" | sed "s/'/''/g")

cat > "$APP_DIR/.env" <<EOF
PORT=8080
GIN_MODE=release
AWS_REGION=$REGION
DATABASE_URL=postgresql://$DB_USER:$DB_PASS_URLENCODED@localhost:5432/$DB_NAME?sslmode=disable
JWT_SECRET=$(echo "$SECRET_JSON" | jq -r .jwt_secret)
OPENSEARCH_ENDPOINT=https://$OS_HOST
OPENSEARCH_INDEX=$OS_INDEX
OPENSEARCH_INDICES=$OS_INDEX
OPENSEARCH_MASTER_USER=$(echo "$SECRET_JSON" | jq -r .opensearch_master_user)
OPENSEARCH_MASTER_PASSWORD=$(echo "$SECRET_JSON" | jq -r .opensearch_master_pass)
S3_UPLOAD_BUCKET=$BUCKET
S3_UPLOAD_PREFIX=ingest/raw/
VAPID_PUBLIC_KEY=$(echo "$SECRET_JSON" | jq -r .vapid_public_key)
VAPID_PRIVATE_KEY=$(echo "$SECRET_JSON" | jq -r .vapid_private_key)
VAPID_SUBJECT=$(echo "$SECRET_JSON" | jq -r .vapid_subject)
EOF
chmod 600 "$APP_DIR/.env"
chown ubuntu:ubuntu "$APP_DIR/.env"

# --- PostgreSQL (local, as today: DATABASE_URL points at localhost) -------
sudo -u postgres psql -v ON_ERROR_STOP=1 <<SQL
DO \$\$ BEGIN
  IF NOT EXISTS (SELECT FROM pg_roles WHERE rolname = '$DB_USER') THEN
    CREATE ROLE $DB_USER LOGIN PASSWORD '$DB_PASS_SQL';
  ELSE
    ALTER ROLE $DB_USER WITH PASSWORD '$DB_PASS_SQL';
  END IF;
END \$\$;
SQL
sudo -u postgres psql -tAc "SELECT 1 FROM pg_database WHERE datname='$DB_NAME'" | grep -q 1 \
  || sudo -u postgres createdb -O "$DB_USER" "$DB_NAME"

# --- nginx (same shape as backend/nginx.conf; certbot adds SSL later) -----
cat > /etc/nginx/sites-available/notorious <<EOF
server {
    listen 80;
    server_name $DOMAIN;
    client_max_body_size 200M;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$scheme;
        proxy_set_header Upgrade \$http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 3600;
        proxy_send_timeout 3600;
    }
}
EOF
ln -sf /etc/nginx/sites-available/notorious /etc/nginx/sites-enabled/notorious
rm -f /etc/nginx/sites-enabled/default
nginx -t && systemctl reload nginx

# --- Ingestion service (replaces tmux) -------------------------------------
# migrate.sh uploads the ingest binary + runner script to /opt/notorious and
# starts this unit once the JSON file is downloaded to /data.
cat > /etc/systemd/system/notorious-ingest.service <<EOF
[Unit]
Description=Notorious OpenSearch ingestion (auto-resume)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=$APP_DIR
Environment=INGEST_BIN=/opt/notorious/ingest
ExecStart=/opt/notorious/run_ingest_with_auto_resume.sh --mode=json --file=/data/DATA_FILE_NAME
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
EOF
# Second ingestion: the Delhi-NCR CSV -> people-delhi-ncr-0001.
# Started separately (./migrate.sh start-csv) once the JSON ingestion is
# under way, so the two do not fight over the small instance's CPUs.
cat > /etc/systemd/system/notorious-ingest-csv.service <<EOF
[Unit]
Description=Notorious OpenSearch CSV ingestion (auto-resume)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=$APP_DIR
Environment=INGEST_CSV_BIN=/opt/notorious/ingest_csv
ExecStart=/opt/notorious/run_ingest_with_auto_resume.sh --mode=csv --file=/data/CSV_FILE_NAME --region=delhi-ncr
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
EOF
systemctl daemon-reload

touch /var/log/notorious-bootstrap.done
echo "bootstrap complete"
