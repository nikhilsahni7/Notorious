# Copy to migrate.env (gitignored) and fill in.
# AWS CLI profiles for the two accounts (~/.aws/credentials). Must be
# DIFFERENT accounts - migrate.sh refuses to run otherwise.
OLD_PROFILE=old-account
NEW_PROFILE=new-account
NEW_REGION=us-east-2

# Where the data lives in the OLD account today (verified on the old EC2).
# The bucket holds a ZIP of the JSON; it is unzipped on the new EC2.
OLD_BUCKET=usersbackupdata
DATA_S3_KEY="users_data - Copy.zip"
JSON_FILE_NAME=users_data.json
# Second dataset: 17GB CSV on the old EC2, uploaded to the old bucket by
# migrate.sh, then copied cross-account like the zip.
CSV_LOCAL_PATH=/home/ubuntu/ncr_data/dela.csv
CSV_S3_KEY=ncr_data/dela.csv
CSV_FILE_NAME=dela.csv

# Old EC2 (for the Postgres dump, CSV upload + letsencrypt copy).
OLD_EC2_HOST=3.16.42.195
OLD_EC2_USER=ubuntu
OLD_EC2_SSH_KEY=~/Downloads/aditya.pem
# Defaults to: sudo -u postgres pg_dump -Fc notorious
# OLD_DUMP_CMD="pg_dump postgresql://notorious_user:PASS@localhost:5432/notorious -Fc"

# Private key matching ssh_public_key_path in infra/terraform.tfvars.
NEW_EC2_SSH_KEY=~/.ssh/id_ed25519

DOMAIN=api.knotorious.us

# Doc counts from the old OpenSearch (2026-11-05). `finish` refuses to cut
# over if the new index does not match exactly.
EXPECTED_DOC_COUNT=1782434387
CSV_EXPECTED_DOC_COUNT=98090524
