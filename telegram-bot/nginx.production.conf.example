# Install only after DNS points to this host and the TLS certificate exists.
server {
    listen 80;
    listen [::]:80;
    server_name bot.knotoriousai.online;
    location /.well-known/acme-challenge/ { root /var/www/shakil-acme; }
    location / { return 301 https://$host$request_uri; }
}
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name bot.knotoriousai.online;
    ssl_certificate /etc/letsencrypt/live/bot.knotoriousai.online/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/bot.knotoriousai.online/privkey.pem;
    client_max_body_size 1m;
    location = /telegram/webhook {
        proxy_pass http://127.0.0.1:8091;
        proxy_set_header Host $host;
        proxy_read_timeout 40s;
    }
    location / { return 404; }
}
